---
interface Props {
  frontmatter: {
    title: string;
    authorityName: string;
    authorityLink: string;
    earnedDate: string;
    expiresDate?: string;
  };
}

const { title, authorityName, authorityLink, earnedDate, expiresDate } =
  Astro.props.frontmatter;
---

<div class="certification" id={title.toLowerCase()}>
  <div class="certification-heading">
    <h3>{title}</h3>
    <a href={authorityLink} target="_blank">{authorityName}</a>
  </div>
  <span>{earnedDate}</span>
  {
    expiresDate !== undefined && (
      <>
        <span>-</span>
        <span>{expiresDate}</span>
      </>
    )
  }
  <slot />
</div>

<style>
  .certification-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
